# Server config
PORT=3000
HOST=0.0.0.0

# JWT secret (ganti dengan random string panjang)
JWT_SECRET=change-this-to-a-random-string-min-32-chars

# Daily limit per plan (request/hari)
LIMIT_FREE=100
LIMIT_PREMIUM=999999

# Admin (hanya admin yang bisa upgrade plan user lain via /api/admin/...)
# Username admin pertama yang register otomatis jadi admin.
# Kalau mau set manual: ADMIN_USERNAME=habibi
ADMIN_USERNAME=

# Optional: Groq API key untuk endpoint /api/ai/chat
# Daftar gratis di https://console.groq.com
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile

# Optional: Google Gemini API key untuk endpoint /api/ai/gemini
# Daftar gratis di https://aistudio.google.com/app/apikey
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash

# Optional: User-Agent untuk scraper (kasih default browser modern)
SCRAPER_UA=Mozilla/5.0 (Windows NT 10.0; Win64; x64) AppleWebKit/537.36 (KHTML, like Gecko) Chrome/120.0.0.0 Safari/537.36
